<%- include('includes/header') %>

<link rel="stylesheet" href="/css/login.css">



<body>
    <form onsubmit="return validateSignUpForm()" class="login_container" action="/feyri/sign-up" method="POST"
        enctype="multipart/form-data">
        <div class="login_frame" style="width: 650px; height: 730px;">

            <div class="login_top">
                <span>Ro'yxatdan o'tish</span>
                <div>Bosh sahifaga qaytarish <a href="/feyri" style="color: #6440fb;">Home</a>
                </div>
                <p>
                    Ro'yxatdan allaqachon o'tmaganmisiz?
                    <a href="/feyri/login" style="color: rgb(100, 64, 251);">Login</a>
                </p>
            </div>

            <div class="sign_input_frame">
                <div class="sign_up_frame">
                    <label>Foydalanuvchining ismi</label>
                    <input type="text" name="mb_nick" class="mb_nick" placeholder="Foydalanuvchining ismi" value=""
                        required>
                </div>


                <div class="sign_up_frame">
                    <label>Telefon raqam</label>
                    <input type="text" name="mb_phone" class="mb_phone" placeholder="Telefon raqam" value="" required>
                </div>
            </div>





            <div class="sign_input_frame">
                <div class="sign_up_frame">
                    <label>Password</label>
                    <input type="password" name="mb_password" class="mb_password" placeholder="passwordni kiriting"
                        value="" required>
                </div>

                <div class="sign_up_frame">
                    <label>Passwordni qayta kiriting</label>
                    <input type="password" name="mb_confirm_password" class="mb_confirm_password"
                        placeholder="passwordni tasdiqlash!" value="" required />
                </div>
            </div>



            <div class="login_input_frame">
                <div class="media-frame">
                    <img class="upload_img_frame" src="/images/default_resto.png">
                    <div class="upload_container">
                        <span class="media_text">Brand rasmi</span>
                        <div class="filebox bs3-primary preview-image">
                            <input class="upload-name" value="Rasmni tanlang" disabled="disabled">
                            <label for="input_file">Rasm yuklash</label>
                            <input type="file" id="input_file" name="restaurant_img"
                                class="upload-hidden form-control-file restaurant_img" />
                        </div>
                        <p class="thumbnail_desc">
                            Brand rasmingizni bu yerga yuklang. <br /> Muhim ko'rsatmalar: .jpg, .jpeg, yoki .png.
                            <br /> rasmda matn yo'q bo'lishi darkor!
                        </p>
                    </div>
                </div>
            </div>

            <button class="login_btn btn" name="signup" type="submit">Ro'yxatdan o'tish</button>


        </div>
    </form>
